{
  "name": "agentkit",
  "version": "0.1.0",
  "private": false,
  "description": "Fork \u2192 configure \u2192 deploy. A fully modular AI agent kit.",
  "keywords": [
    "ai",
    "agent",
    "nextjs",
    "modular",
    "open-source",
    "agentkit"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "^16.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "geist": "latest",
    "ai": "^6.0.0",
    "@ai-sdk/google": "latest",
    "@ai-sdk/openai": "latest",
    "@ai-sdk/anthropic": "latest",
    "@ai-sdk/groq": "latest",
    "zod": "^4.3.6",
    "@supabase/supabase-js": "^2.0.0",
    "resend": "latest",
    "react-markdown": "latest",
    "remark-gfm": "latest",
    "clsx": "latest",
    "tailwind-merge": "latest",
    "sonner": "latest",
    "lucide-react": "latest",
    "yaml": "latest",
    "next-themes": "latest",
    "@ai-sdk/react": "latest"
  },
  "devDependencies": {
    "eslint": "^10.0.0",
    "@eslint/js": "^10.0.0",
    "eslint-config-next": "latest",
    "eslint-config-prettier": "latest",
    "prettier": "^3.0.0",
    "husky": "latest",
    "lint-staged": "latest",
    "tw-animate-css": "latest",
    "@tailwindcss/postcss": "latest",
    "postcss": "latest"
  },
  "lint-staged": {
    "*.{js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml,css}": [
      "prettier --write"
    ]
  }
}
